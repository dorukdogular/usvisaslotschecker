# Timezone
TZ=Asia/Istanbul

# Data source: checkvisaslots (default) | official (Phase-2 stub)
SOURCE=checkvisaslots
API_KEY=your-checkvisaslots-api-key

# Istanbul targeting
VISA_LOCATIONS=ISTANBUL
VISA_CATEGORIES=B1/B2
VISA_DURATION_DAYS=120
REQUIRE_BOTH_CONSULATE_AND_VAC=false

# Scheduling (loop mode)
RUN_MODE=loop
CHECK_INTERVAL_MINUTES=5
CHECK_JITTER_SECONDS=90
DEDUPE_HOURS=6
NOTIFY=true
DRY_RUN=false

# Proxy (compose service defaults to http://proxy:8888)
# For local simple proxy: PROXY_URL=http://127.0.0.1:8888
PROXY_URL=http://proxy:8888

# Optional Cloudflare solver (docker compose --profile cf up -d)
# CF_SOLVER_URL=http://flaresolverr:8191

# Telegram (primary notification channel)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=your-chat-id

# Email (backup)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-specific-password
RECEIVER_EMAIL=recipient@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Optional Pushover
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# Phase-2 official source (disabled by default — do not auto-book)
# OFFICIAL_EMAIL=
# OFFICIAL_PASSWORD=
# OFFICIAL_BASE_URL=https://www.ustraveldocs.com/tr
